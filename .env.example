# Copy to .env and fill in — never commit the real .env file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secrets (Supabase Edge Function) — set via `supabase secrets set`,
# never put these in this file or prefix them with VITE_ (that gets bundled client-side).
# RESEND_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
